#!/usr/bin/env bash
# Fake gh for deploy/tests/deploy-sh.test.sh. Records calls in
# $STUB_STATE/calls.log. STUB_GH_AUTH=no fails `gh auth status`. STUB_CI is a
# comma-separated list of run states, one per `gh run list` (the last repeats):
# none, success, failure, cancelled, in_progress, queued. Prints what
# deploy.sh's --jq expression would.
set -euo pipefail
state=${STUB_STATE:?}
printf 'gh %s\n' "$*" >> "$state/calls.log"

case "$1 $2" in
  "auth status")
    [ "${STUB_GH_AUTH:-yes}" = yes ] || { echo "You are not logged into any GitHub hosts." >&2; exit 1; }
    ;;
  "run list")
    n=$(cat "$state/gh_run_list_calls" 2>/dev/null || echo 0)
    echo $((n + 1)) > "$state/gh_run_list_calls"
    IFS=, read -r -a seq <<<"${STUB_CI:-success}"
    idx=$n
    [ "$idx" -lt "${#seq[@]}" ] || idx=$((${#seq[@]} - 1))
    url=https://github.com/test-owner/test-repo/actions/runs/101
    case "${seq[$idx]}" in
      none) ;;
      success|failure|cancelled) echo "completed ${seq[$idx]} 101 $url" ;;
      *) echo "${seq[$idx]} - 101 $url" ;;
    esac
    ;;
  "run view")
    echo "  - Thorough tier, shard 1/10: failure"
    ;;
  *)
    echo "stub gh: unhandled: $*" >&2
    exit 1
    ;;
esac
