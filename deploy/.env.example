# Copy to deploy/.env and fill in. deploy/.env is gitignored.

# Host directory for all persistent data. Created on first run:
#   <root>/postgres  database files
#   <root>/home      Paperclip home (repo clones, worktrees, uploads, secrets key)
PAPERCLIP_DATA_ROOT=/srv/paperclip

# Your server user's IDs (`id -u` and `id -g`), so files the agents create
# under <root>/home are owned by you.
USER_UID=1000
USER_GID=1000

# The URL people use to open Paperclip, e.g. https://paperclip.example.com
# or your Tailscale serve URL https://<machine>.<tailnet>.ts.net
PAPERCLIP_PUBLIC_URL=
# private = VPN/Tailscale/LAN only; public = internet-facing (behind Caddy)
PAPERCLIP_DEPLOYMENT_EXPOSURE=private
# Extra hostnames to accept besides the public URL's host, comma-separated.
PAPERCLIP_ALLOWED_HOSTNAMES=

# Where the container listens on the host. Keep loopback and put Caddy or
# `tailscale serve` in front; set 0.0.0.0 only for direct LAN access.
PAPERCLIP_BIND_ADDR=127.0.0.1
PAPERCLIP_PORT=3100

# Secrets: generate each with `openssl rand -hex 32`. Keep them stable;
# changing BETTER_AUTH_SECRET signs everyone out.
POSTGRES_PASSWORD=
BETTER_AUTH_SECRET=
PAPERCLIP_TOOL_ACTION_SIGNING_SECRET=

# Optional: GitHub token for cloning private repos (prefer a company secret
# named GITHUB_TOKEN in the UI, which is scoped to one company).
GITHUB_TOKEN=

# LLM provider keys for agents (at least one).
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
